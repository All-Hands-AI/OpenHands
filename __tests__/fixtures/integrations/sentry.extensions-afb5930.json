{
  "id": "sentry",
  "name": "Sentry",
  "description": "Triage issues, inspect events, and run Seer fixes against your Sentry org.",
  "categories": [
    "Observability",
    "Engineering"
  ],
  "appUrl": "https://sentry.io",
  "docsUrl": "https://docs.sentry.io/product/sentry-mcp/",
  "notes": "Natural target for engineering support agents.",
  "popularityRank": 36,
  "connectionOptions": [
    {
      "id": "oauth-mcp",
      "provider": "mcp",
      "transport": {
        "kind": "shttp",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "auth": {
        "strategy": "oauth2",
        "oauth": {
          "authorizationUrl": "https://sentry.io/oauth/authorize",
          "tokenUrl": "https://sentry.io/oauth/token",
          "scopes": [
            "project:read",
            "event:read",
            "org:read"
          ]
        }
      }
    },
    {
      "id": "oauth",
      "provider": "http",
      "auth": {
        "strategy": "oauth2",
        "oauth": {
          "authorizationUrl": "https://sentry.io/oauth/authorize",
          "tokenUrl": "https://sentry.io/oauth/token",
          "scopes": [
            "project:read",
            "event:read",
            "org:read"
          ]
        }
      },
      "http": {
        "apiBaseUrl": "https://sentry.io/api/0",
        "openApiUrl": "https://raw.githubusercontent.com/getsentry/sentry/master/api-docs/openapi.json"
      }
    },
    {
      "id": "mcp",
      "provider": "mcp",
      "transport": {
        "kind": "shttp",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "auth": {
        "strategy": "oauth2",
        "oauth": {
          "clientAuthentication": "none"
        }
      }
    },
    {
      "id": "api",
      "provider": "mcp",
      "transport": {
        "kind": "stdio",
        "serverName": "sentry",
        "command": "npx",
        "args": [
          "-y",
          "@sentry/mcp-server"
        ],
        "envFields": [
          {
            "key": "SENTRY_ACCESS_TOKEN",
            "label": "Personal auth token",
            "type": "password",
            "placeholder": "sntryu_...",
            "required": true,
            "helperText": "Create a [personal auth token](https://docs.sentry.io/account/auth-tokens/) with org:read, project:read, project:write, team:read, team:write, event:read and event:write. With read scopes only, tools that change issues or projects fail. On a self-hosted server, create it there."
          },
          {
            "key": "SENTRY_HOST",
            "label": "Self-hosted Sentry host",
            "type": "text",
            "placeholder": "sentry.example.com",
            "required": false,
            "helperText": "Leave empty for sentry.io. For a self-hosted server, enter its hostname without https://."
          }
        ]
      },
      "auth": {
        "strategy": "api_key"
      }
    }
  ],
  "iconBg": "#362D59",
  "logoUrl": "https://cdn.simpleicons.org/sentry/FFFFFF",
  "keywords": [
    "errors",
    "observability",
    "monitoring",
    "crash"
  ]
}
